<?xml version="1.0" encoding="utf-8"?>
<!-- 关水按钮：红色渐变（危险动作），深浅色各一档 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/btn_stop_bottom"
                android:startColor="@color/btn_stop_top"
                android:type="linear" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</ripple>
